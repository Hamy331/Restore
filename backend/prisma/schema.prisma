generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?       
  fullName       String
  username       String        @unique
  phone          String?
  avatarUrl      String?
  role           Role          @default(USER)
  status         AccountStatus @default(UNVERIFIED)
  authVersion    Int           @default(0)
  ratingAverage  Float         @default(0.0)
  ratingCount    Int           @default(0)
  otpCode        String?
  otpExpires     DateTime?
  otpPurpose     OtpPurpose?
  otpAttempts    Int           @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listings       Listing[]
  authSessions   AuthSession[]
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  EXCHANGED
}

model Listing {
  id            String           @id @default(uuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id])
  title         String
  description   String
  price         Decimal
  isNegotiable  Boolean          @default(true)
  condition     ListingCondition
  status        ListingStatus    @default(AVAILABLE)
  allowSale     Boolean          @default(true)
  allowExchange Boolean          @default(false)
  images        String[]         
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}
