generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?       
  fullName       String
  username       String        @unique
  phone          String?
  avatarUrl      String?
  role           Role          @default(USER)
  status         AccountStatus @default(UNVERIFIED)
  suspendedUntil DateTime?
  authVersion    Int           @default(0)
  ratingAverage  Float         @default(0.0)
  ratingCount    Int           @default(0)
  otpCode        String?
  otpExpires     DateTime?
  otpPurpose     OtpPurpose?
  otpAttempts    Int           @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listings       Listing[]
  favorites      ListingFavorite[]
  authSessions   AuthSession[]
  storeSubscription StoreSubscription?
  storeOrders    StoreOrder[]
  promotions     Promotion[]
  promotionOrders PromotionOrder[]
  wantedAlerts   WantedAlert[]
  @@index([status, suspendedUntil])
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  PENDING
  REJECTED
  AVAILABLE
  HIDDEN
  RESERVED
  SOLD
  EXCHANGED
}

model Listing {
  id            String           @id @default(uuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  title         String
  description   String
  price         Decimal
  isNegotiable  Boolean          @default(true)
  condition     ListingCondition?
  status        ListingStatus    @default(AVAILABLE)
  allowSale     Boolean          @default(true)
  allowExchange Boolean          @default(false)
  exchangeWish  String           @default("")
  sellerType    String           @default("PERSONAL")
  attributes    Json             @default("{}")
  location      Json?
  reviewReason  String?
  images        String[]         
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  publishedAt   DateTime?
  updatedAt     DateTime         @updatedAt
  promotions    Promotion[]
  favorites     ListingFavorite[]
  promotionOrders PromotionOrder[]
  wantedAlertMatches WantedAlertMatch[]

  @@index([ownerId, publishedAt])
}

model ListingFavorite {
  userId String
  listingId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
  @@index([listingId])
}

model Category {
  active         Boolean             @default(true)
  id             String              @id
  name           String
  metadata       Json                @default("{}")
  listings       Listing[]
  subscriptions  StoreSubscription[]
  storeOrders    StoreOrder[]
  wantedAlerts   WantedAlert[]
}

enum StoreTier {
  PERSONAL
  BASIC
  PRO
}

model StorePackage {
  id                    String              @id
  tier                  StoreTier           @unique
  name                  String
  monthlyPrice          Decimal
  dailyListingLimit     Int
  activeListingLimit    Int
  monthlyPromotionQuota Int
  priorityLevel         Int
  subscriptions         StoreSubscription[]
  orders                StoreOrder[]
}

model StoreSubscription {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   StorePackage @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])
  startsAt  DateTime     @default(now())
  endsAt    DateTime
  updatedAt DateTime     @updatedAt
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model StoreOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    StorePackage     @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category         @relation(fields: [categoryId], references: [id])
  amount     Decimal
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  @@index([userId, status])
}

model PromotionPackage {
  id           String      @id
  name         String
  kind         PromotionKind
  durationDays Int
  price        Decimal
  priority     Int
  active       Boolean     @default(true)
  promotions   Promotion[]
  orders       PromotionOrder[]
}

enum PromotionKind {
  BUMP
  FEATURED
}

enum PromotionSource {
  INCLUDED
  PURCHASED
}

model Promotion {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId String
  package   PromotionPackage @relation(fields: [packageId], references: [id])
  source    PromotionSource  @default(INCLUDED)
  orderId   String?          @unique
  order     PromotionOrder?  @relation(fields: [orderId], references: [id])
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([listingId, endsAt])
}

model PromotionOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId  String
  package    PromotionPackage @relation(fields: [packageId], references: [id])
  amount     Decimal
  status     PurchaseStatus   @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?
  promotion  Promotion?

  @@index([userId, status])
}

model AdminAudit {
  id String @id @default(uuid())
  actorId String
  action String
  targetType String
  targetId String
  reason String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}
model ConditionPolicy {
  condition ListingCondition @id
  name String
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
model ViolationReport {
  id String @id @default(uuid())
  reporterId String
  targetType String
  targetId String
  reason String
  evidence String
  status ReportStatus @default(OPEN)
  decision String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([reporterId])
}
enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}
model BlogPost {
  id String @id @default(uuid())
  title String
  slug String @unique
  content String
  category String
  coverUrl String?
  listingIds String[]
  status PostStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model SupportTicket {
  id String @id @default(uuid())
  userId String
  subject String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages SupportMessage[]
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}
model SupportMessage {
  id String @id @default(uuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  isAdmin Boolean
  content String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model KnowledgeDocument {
  id String @id @default(uuid())
  title String
  content String
  indexedText String?
  syncedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

/// Banner ảnh ở trang chủ (ảnh 1200 × 600). Admin quản lý qua /api/v1/home/admin/banners.
model HomeBanner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String?
  route     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

enum WantedAlertMatchLevel {
  BROAD
  BALANCED
  STRICT
}

/// "Báo khi có hàng": người dùng đặt trước món muốn mua. Khi admin duyệt một tin
/// gần giống (điểm >= ngưỡng của matchLevel) thì ghi một WantedAlertMatch.
/// API: /api/v1/wanted-alerts. Xóa dòng là dừng thông báo.
model WantedAlert {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords      String
  categoryId    String?
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Khoảng giá VND, null là không giới hạn
  minPrice      BigInt?
  maxPrice      BigInt?
  /// Rỗng là mọi tình trạng / mọi kiểu giao dịch ("buy", "exchange")
  conditions    ListingCondition[]
  dealTypes     String[]
  /// Khu vực: mã tỉnh (areaLevel "province") hoặc mã phường ("ward"); null là toàn quốc
  areaCode      String?
  areaLevel     String?
  areaLabel     String?
  matchLevel    WantedAlertMatchLevel @default(BALANCED)
  /// Lần cuối người dùng mở xem tin khớp; tin khớp sau mốc này là tin mới
  seenAt        DateTime              @default(now())
  lastMatchedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  matches       WantedAlertMatch[]

  @@index([userId, createdAt])
  @@index([categoryId])
}

/// Một tin đã khớp một thông báo, kèm điểm giống 0..1
model WantedAlertMatch {
  alertId   String
  alert     WantedAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Float
  matchedAt DateTime    @default(now())

  @@id([alertId, listingId])
  @@index([alertId, matchedAt])
  @@index([listingId])
}
