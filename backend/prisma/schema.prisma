generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  feedPosts FeedPost[]
  feedComments FeedComment[]
  feedLikes FeedPostLike[]
  feedCommentLikes FeedCommentLike[]
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?       
  fullName       String
  username       String        @unique
  phone          String?
  avatarUrl      String?
  bio            String?        @db.VarChar(300)
  lastActiveAt   DateTime?
  role           Role          @default(USER)
  status         AccountStatus @default(UNVERIFIED)
  suspendedUntil DateTime?
  authVersion    Int           @default(0)
  ratingAverage  Float         @default(0.0)
  ratingCount    Int           @default(0)
  otpCode        String?
  otpExpires     DateTime?
  otpPurpose     OtpPurpose?
  otpAttempts    Int           @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listings       Listing[]
  favorites      ListingFavorite[]
  authSessions   AuthSession[]
  chatMembers    ConversationMember[]
  chatMessages   Message[]
  storeSubscription StoreSubscription?
  storeOrders    StoreOrder[]
  promotions     Promotion[]
  promotionOrders PromotionOrder[]
  wantedAlerts   WantedAlert[]
  creditTopups   CreditTopupOrder[]
  creditTransactions CreditTransaction[]
  creditHolds    CreditHold[]

  followers      UserFollow[]  @relation("FollowedUser")
  following      UserFollow[]  @relation("FollowingUser")
  shop           Shop?
  shopFollows    ShopFollow[]

  @@index([status, suspendedUntil])
}

model UserFollow {
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id        String @id @default(uuid())
  pairKey   String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId String
  lastReadSequence Int @default(0)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(uuid())
  sequence Int @unique @default(autoincrement())
  conversationId String
  senderId String
  clientId String
  text String @db.VarChar(2000)
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, sequence])
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  PENDING
  REJECTED
  AVAILABLE
  HIDDEN
  RESERVED
  SOLD
  EXCHANGED
}

model Listing {
  feedPosts FeedPost[]
  id            String           @id @default(uuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  title         String
  description   String
  price         Decimal
  /// Giá gốc trước khi giảm (null = không giảm); > price thì tin hiện ở "Trải nghiệm hàng hiệu"
  originalPrice Decimal?
  isNegotiable  Boolean          @default(true)
  condition     ListingCondition?
  status        ListingStatus    @default(AVAILABLE)
  allowSale     Boolean          @default(true)
  allowExchange Boolean          @default(false)
  exchangeWish  String           @default("")
  sellerType    String           @default("PERSONAL")
  attributes    Json             @default("{}")
  location      Json?
  reviewReason  String?
  images        String[]         
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  publishedAt   DateTime?
  /// Số xu đã giữ/trừ để đăng tin vượt hạn mức; 0 = tin dùng suất miễn phí
  paidCredits   Int              @default(0)
  /// Hết hạn hiển thị (duyệt / kích hoạt lại / gia hạn mới đặt); quá hạn thì tự ẩn
  expiresAt     DateTime?
  /// Ngày hẹn bắt đầu hiển thị (null = hiện ngay khi duyệt). Tin đã duyệt mà chưa tới ngày: HIDDEN + startsAt
  startsAt      DateTime?
  /// Số ngày hiển thị người bán chọn lúc đăng, tính khi duyệt (null = số ngày miễn phí)
  displayDays   Int?
  /// Số ngày hiển thị đã trả xu lúc đăng
  paidDays      Int              @default(0)
  /// Tự gia hạn 30 ngày khi sắp hết hạn (gói có StorePackage.autoExtend)
  autoExtend    Boolean          @default(false)
  updatedAt     DateTime         @updatedAt
  creditHolds   CreditHold[]
  promotions    Promotion[]
  favorites     ListingFavorite[]
  promotionOrders PromotionOrder[]
  wantedAlertMatches WantedAlertMatch[]

  @@index([ownerId, publishedAt])
  @@index([ownerId, categoryId, status])
  @@index([status, expiresAt])
  @@index([status, startsAt])
}

model ListingFavorite {
  userId String
  listingId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
  @@index([listingId])
}

model Category {
  active         Boolean             @default(true)
  id             String              @id
  name           String
  metadata       Json                @default("{}")
  /// Tài khoản Cá nhân: số tin miễn phí đang hiển thị/chờ duyệt trong chuyên mục
  freeListingLimit    Int            @default(2)
  /// Giá (xu) một tin vượt hạn mức, hiển thị 60 ngày
  extraListingCredits Int            @default(5)
  /// Số ngày hiển thị miễn phí của gói Cá nhân (gói cao nhân theo StorePackage.freeDaysPercent)
  displayDays         Int            @default(60)
  /// Thời gian hiển thị tối đa (ngày, tính từ hôm nay) khi chọn ngày đăng hoặc gia hạn
  maxDisplayDays      Int            @default(120)
  /// Giá (xu) cho 30 ngày hiển thị thêm; giá một ngày = giá này / 30, làm tròn lên
  dayPackCredits      Int            @default(4)
  /// Giá (xu) một lần đẩy tin lên đầu, trước khi giảm theo gói
  boostCredits        Int            @default(5)
  listings       Listing[]
  subscriptions  StoreSubscription[]
  storeOrders    StoreOrder[]
  wantedAlerts   WantedAlert[]
}

enum StoreTier {
  PERSONAL
  BASIC
  PRO
}

model StorePackage {
  id                    String              @id
  tier                  StoreTier           @unique
  name                  String
  monthlyPrice          Decimal
  dailyListingLimit     Int
  activeListingLimit    Int
  /// Số tin nháp được giữ cùng lúc
  draftLimit            Int                 @default(3)
  monthlyPromotionQuota Int
  /// Phần trăm giảm giá đẩy tin bằng xu của gói
  boostDiscountPercent  Int                 @default(0)
  /// Số ngày hiển thị miễn phí theo % của Category.displayDays (Cá nhân 100, Bán chuyên 150, Cửa hàng 200)
  freeDaysPercent       Int                 @default(100)
  /// Giảm giá (%) khi mua thêm ngày hiển thị
  extendDiscountPercent Int                 @default(0)
  /// Được bật tự gia hạn tin 30 ngày khi sắp hết hạn
  autoExtend            Boolean             @default(false)
  priorityLevel         Int
  subscriptions         StoreSubscription[]
  orders                StoreOrder[]
}

model StoreSubscription {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   StorePackage @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])
  startsAt  DateTime     @default(now())
  endsAt    DateTime
  updatedAt DateTime     @updatedAt
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model StoreOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    StorePackage     @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category         @relation(fields: [categoryId], references: [id])
  amount     Decimal
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  @@index([userId, status])
}

model PromotionPackage {
  id           String      @id
  name         String
  kind         PromotionKind
  durationDays Int
  price        Decimal
  priority     Int
  active       Boolean     @default(true)
  promotions   Promotion[]
  orders       PromotionOrder[]
}

enum PromotionKind {
  BUMP
  FEATURED
}

enum PromotionSource {
  INCLUDED
  PURCHASED
}

model Promotion {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId String
  package   PromotionPackage @relation(fields: [packageId], references: [id])
  source    PromotionSource  @default(INCLUDED)
  orderId   String?          @unique
  order     PromotionOrder?  @relation(fields: [orderId], references: [id])
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([listingId, endsAt])
}

model PromotionOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId  String
  package    PromotionPackage @relation(fields: [packageId], references: [id])
  amount     Decimal
  status     PurchaseStatus   @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?
  promotion  Promotion?

  @@index([userId, status])
}

model AdminAudit {
  id String @id @default(uuid())
  actorId String
  action String
  targetType String
  targetId String
  reason String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}
model ConditionPolicy {
  condition ListingCondition @id
  name String
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
model ViolationReport {
  id String @id @default(uuid())
  reporterId String
  targetType String
  targetId String
  reason String
  evidence String
  status ReportStatus @default(OPEN)
  decision String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([reporterId])
}
enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}
model BlogPost {
  id String @id @default(uuid())
  title String
  slug String @unique
  content String
  category String
  coverUrl String?
  listingIds String[]
  status PostStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model SupportTicket {
  id String @id @default(uuid())
  userId String
  subject String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages SupportMessage[]
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}
model SupportMessage {
  id String @id @default(uuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  isAdmin Boolean
  content String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model KnowledgeDocument {
  id String @id @default(uuid())
  title String
  content String
  indexedText String?
  syncedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}
model FeedPost {
  id String @id @default(uuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text String @db.VarChar(2000)
  imageUrl String?
  listingId String?
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes FeedPostLike[]
  comments FeedComment[]
  @@index([createdAt, id])
  @@index([authorId, createdAt, id])
}
model FeedPostLike {
  postId String
  userId String
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([postId, userId])
}
model FeedComment {
  id String @id @default(uuid())
  postId String
  authorId String
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text String @db.VarChar(2000)
  imageUrl String?
  parentId String?
  parent FeedComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies FeedComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes FeedCommentLike[]
  @@index([postId, createdAt, id])
  @@index([parentId, createdAt, id])
}
model FeedCommentLike {
  commentId String
  userId String
  comment FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([commentId, userId])
}

/// Banner ảnh ở trang chủ (ảnh 1200 × 600). Admin quản lý qua /api/v1/home/admin/banners.
model HomeBanner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String?
  route     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

enum WantedAlertMatchLevel {
  BROAD
  BALANCED
  STRICT
}

/// "Báo khi có hàng": người dùng đặt trước món muốn mua. Khi admin duyệt một tin
/// gần giống (điểm >= ngưỡng của matchLevel) thì ghi một WantedAlertMatch.
/// API: /api/v1/wanted-alerts. Xóa dòng là dừng thông báo.
model WantedAlert {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords      String
  categoryId    String?
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Khoảng giá VND, null là không giới hạn
  minPrice      BigInt?
  maxPrice      BigInt?
  /// Rỗng là mọi tình trạng / mọi kiểu giao dịch ("buy", "exchange")
  conditions    ListingCondition[]
  dealTypes     String[]
  /// Khu vực: mã tỉnh (areaLevel "province") hoặc mã phường ("ward"); null là toàn quốc
  areaCode      String?
  areaLevel     String?
  areaLabel     String?
  matchLevel    WantedAlertMatchLevel @default(BALANCED)
  /// Lần cuối người dùng mở xem tin khớp; tin khớp sau mốc này là tin mới
  seenAt        DateTime              @default(now())
  lastMatchedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  matches       WantedAlertMatch[]

  @@index([userId, createdAt])
  @@index([categoryId])
}

/// Một tin đã khớp một thông báo, kèm điểm giống 0..1
model WantedAlertMatch {
  alertId   String
  alert     WantedAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Float
  matchedAt DateTime    @default(now())

  @@id([alertId, listingId])
  @@index([alertId, matchedAt])
  @@index([listingId])
}

/// Xu ReStore (credit). 1 xu = 1.000 đ. Số dư = tổng CreditTransaction.amount
enum CreditPayMethod {
  VNPAY
  VIETQR
  ZALOPAY
}

enum TopupStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum CreditTxnType {
  TOPUP
  BONUS
  SPEND
  REFUND
  EXPIRE
  ADJUST
}

/// Xu nạp (PAID) hay xu tặng (BONUS); tiêu xu tặng trước
enum CreditBucket {
  PAID
  BONUS
}

/// Gói nạp xu, admin sửa được
model CreditPackage {
  id           String             @id
  priceVnd     Int
  credits      Int
  bonusCredits Int                @default(0)
  popular      Boolean            @default(false)
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  orders       CreditTopupOrder[]
}

/// Đơn nạp xu; chỉ chuyển PAID khi cổng xác nhận (IPN có chữ ký) hoặc cổng thử
model CreditTopupOrder {
  id            String              @id @default(uuid())
  /// Mã ngắn ghi vào nội dung chuyển khoản
  code          String              @unique
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       CreditPackage       @relation(fields: [packageId], references: [id])
  method        CreditPayMethod
  amountVnd     Int
  credits       Int
  bonusCredits  Int                 @default(0)
  status        TopupStatus         @default(PENDING)
  /// Mã giao dịch của cổng, mỗi mã chỉ cộng xu một lần
  providerTxnId String?             @unique
  /// Mã đơn bên cổng (ZaloPay app_trans_id) để hỏi trạng thái và khớp callback
  providerRef   String?             @unique
  /// Trang thanh toán của cổng
  payUrl        String?
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transactions  CreditTransaction[]

  @@index([userId, status])
}

/// Sổ cái xu: chỉ thêm, không sửa, không xoá
model CreditTransaction {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CreditTxnType
  bucket       CreditBucket
  /// Dương là cộng, âm là trừ
  amount       Int
  expiresAt    DateTime?
  topupOrderId String?
  topupOrder   CreditTopupOrder? @relation(fields: [topupOrderId], references: [id], onDelete: SetNull)
  note         String?
  /// Lần giữ xu khi đăng tin (trừ khi giữ, hoàn khi tin bị từ chối)
  holdId       String?
  hold         CreditHold?       @relation(fields: [holdId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@unique([topupOrderId, type])
  @@index([userId, createdAt])
}

enum CreditHoldStatus {
  /// Đã trừ khỏi ví, chờ admin duyệt tin
  HELD
  /// Tin đã duyệt, xu tiêu hẳn
  CAPTURED
  /// Tin bị từ chối hoặc huỷ, xu đã hoàn
  RELEASED
}

/// Xu giữ khi gửi tin vượt hạn mức: trừ ngay khỏi số dư, duyệt thì tiêu hẳn, từ chối thì hoàn
model CreditHold {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  amount       Int
  /// Phần lấy từ xu tặng / xu nạp, để hoàn đúng loại
  bonusAmount  Int
  paidAmount   Int
  status       CreditHoldStatus    @default(HELD)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions CreditTransaction[]

  @@index([userId, status])
  @@index([listingId, status])
}

/// Mốc mua ngày hiển thị rẻ hơn (30 / 60 / 90 ngày), admin sửa được
model DisplayDayPack {
  days            Int     @id
  discountPercent Int
  active          Boolean @default(true)
}

/// Cách shop được xác minh: shop gốc của thương hiệu, hoặc ReStore kiểm tra giấy tờ và cấp chứng nhận
enum ShopVerificationType {
  OFFICIAL_BRAND
  CERTIFIED
}

enum ShopBannerStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Gian hàng của một tài khoản bán (thường là gói Cửa hàng). Chỉ hiện ở "Shop uy tín" khi đã xác minh
model Shop {
  id               String                @id @default(uuid())
  ownerId          String                @unique
  owner            User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  tagline          String                @default("")
  description      String                @default("")
  logoUrl          String?
  coverUrl         String?
  /// Màu nhận diện hex, VD "#1428A0"
  accentColor      String?
  /// null = chưa xác minh
  verificationType ShopVerificationType?
  verifiedAt       DateTime?
  /// Mã chứng nhận ReStore cấp, VD "RS-2026-00128"
  certificateCode  String?
  categoryIds      String[]
  /// Địa chỉ hiển thị, VD "Quận 1, TP. Hồ Chí Minh"
  address          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  followers        ShopFollow[]
  banners          ShopBanner[]

  @@index([verificationType, verifiedAt])
}

model ShopFollow {
  userId    String
  shopId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, shopId])
  @@index([shopId])
}

/// Banner sự kiện shop gửi lên (ảnh 1200 x 600), admin duyệt rồi mới hiện
model ShopBanner {
  id        String           @id @default(uuid())
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String
  startsAt  DateTime?
  endsAt    DateTime?
  status    ShopBannerStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([shopId, status])
}
