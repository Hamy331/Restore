generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?       
  fullName       String
  username       String        @unique
  phone          String?
  avatarUrl      String?
  role           Role          @default(USER)
  status         AccountStatus @default(UNVERIFIED)
  authVersion    Int           @default(0)
  ratingAverage  Float         @default(0.0)
  ratingCount    Int           @default(0)
  otpCode        String?
  otpExpires     DateTime?
  otpPurpose     OtpPurpose?
  otpAttempts    Int           @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listings       Listing[]
  authSessions   AuthSession[]
  storeSubscription StoreSubscription?
  storeOrders    StoreOrder[]
  promotions     Promotion[]
  promotionOrders PromotionOrder[]
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  HIDDEN
  RESERVED
  SOLD
  EXCHANGED
}

model Listing {
  id            String           @id @default(uuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  title         String
  description   String
  price         Decimal
  isNegotiable  Boolean          @default(true)
  condition     ListingCondition
  status        ListingStatus    @default(AVAILABLE)
  allowSale     Boolean          @default(true)
  allowExchange Boolean          @default(false)
  images        String[]         
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  publishedAt   DateTime?
  updatedAt     DateTime         @updatedAt
  promotions    Promotion[]
  promotionOrders PromotionOrder[]

  @@index([ownerId, publishedAt])
}

model Category {
  id             String              @id
  name           String
  listings       Listing[]
  subscriptions  StoreSubscription[]
  storeOrders    StoreOrder[]
}

enum StoreTier {
  PERSONAL
  BASIC
  PRO
}

model StorePackage {
  id                    String              @id
  tier                  StoreTier           @unique
  name                  String
  monthlyPrice          Decimal
  dailyListingLimit     Int
  activeListingLimit    Int
  monthlyPromotionQuota Int
  priorityLevel         Int
  subscriptions         StoreSubscription[]
  orders                StoreOrder[]
}

model StoreSubscription {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   StorePackage @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])
  startsAt  DateTime     @default(now())
  endsAt    DateTime
  updatedAt DateTime     @updatedAt
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model StoreOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    StorePackage     @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category         @relation(fields: [categoryId], references: [id])
  amount     Decimal
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  @@index([userId, status])
}

model PromotionPackage {
  id           String      @id
  name         String
  kind         PromotionKind
  durationDays Int
  price        Decimal
  priority     Int
  active       Boolean     @default(true)
  promotions   Promotion[]
  orders       PromotionOrder[]
}

enum PromotionKind {
  BUMP
  FEATURED
}

enum PromotionSource {
  INCLUDED
  PURCHASED
}

model Promotion {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId String
  package   PromotionPackage @relation(fields: [packageId], references: [id])
  source    PromotionSource  @default(INCLUDED)
  orderId   String?          @unique
  order     PromotionOrder?  @relation(fields: [orderId], references: [id])
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([listingId, endsAt])
}

model PromotionOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId  String
  package    PromotionPackage @relation(fields: [packageId], references: [id])
  amount     Decimal
  status     PurchaseStatus   @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?
  promotion  Promotion?

  @@index([userId, status])
}
