generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  aiConversations AiConversation[]
  aiUsage AiUsage?
  feedPosts FeedPost[]
  feedComments FeedComment[]
  feedLikes FeedPostLike[]
  feedCommentLikes FeedCommentLike[]
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?       
  fullName       String
  username       String        @unique
  /// Lần đổi tên người dùng gần nhất (null: chưa đổi lần nào sau khi đăng ký), dùng để chặn đổi liên tục
  usernameChangedAt DateTime?
  phone          String?
  /// Lúc xác minh số điện thoại bằng OTP (null: chưa xác minh hoặc đã đổi số sau khi xác minh)
  phoneVerifiedAt DateTime?
  avatarUrl      String?
  bio            String?        @db.VarChar(300)
  lastActiveAt   DateTime?
  role           Role          @default(USER)
  status         AccountStatus @default(UNVERIFIED)
  suspendedUntil DateTime?
  authVersion    Int           @default(0)
  legacyRatingCount Int @default(0)
  legacyRatingAverage Float @default(0)
  reviewsGiven TradeReview[] @relation("Author")
  reviewsReceived TradeReview[] @relation("Recipient")
  ratingAverage  Float         @default(0.0)
  ratingCount    Int           @default(0)
  otpCode        String?
  otpExpires     DateTime?
  otpPurpose     OtpPurpose?
  otpAttempts    Int           @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listings       Listing[]
  favorites      ListingFavorite[]
  authSessions   AuthSession[]
  chatMembers    ConversationMember[]
  chatMessages   Message[]
  storeSubscription StoreSubscription?
  storeOrders    StoreOrder[]
  promotions     Promotion[]
  promotionOrders PromotionOrder[]
  wantedAlerts   WantedAlert[]
  creditTopups   CreditTopupOrder[]
  creditTransactions CreditTransaction[]
  creditHolds    CreditHold[]

  followers      UserFollow[]  @relation("FollowedUser")
  following      UserFollow[]  @relation("FollowingUser")
  shop           Shop?
  searchHistory  SearchHistory[]
  notifications  Notification[]
  pushDevices    PushDevice[]
  savedAddresses SavedAddress[]
  recentAreas    RecentArea[]
  recentViews    ListingRecentView[]

  @@index([status, suspendedUntil])
}

/// Thông báo trong app của một người dùng (trang Thông báo, chuông ở trang chủ).
/// `type` là chuỗi (xem NOTIFICATION_TYPES trong modules/notifications/notification.type.ts) để thêm
/// loại mới không cần migration. App dựng câu chữ theo `type` + `data` (đa ngôn ngữ);
/// `title` / `body` là câu tiếng Việt dự phòng do server ghi. `link` là route trong app khi bấm vào.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(48)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(500)
  /// Tham số cho câu chữ: listingId, listingTitle, reason, amount...
  data      Json      @default("{}")
  imageUrl  String?
  link      String?   @db.VarChar(300)
  readAt    DateTime?
  /// Lúc đã xử lý gửi push (FCM); null = chưa gửi. Gửi sau khi transaction ghi thông báo đã commit
  pushedAt  DateTime?
  /// Khoá chống gửi trùng, mỗi người một khoá (VD nhắc tin sắp hết hạn)
  dedupeKey String?   @db.VarChar(160)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([pushedAt, createdAt])
  @@unique([userId, dedupeKey])
}

/// Thiết bị nhận push FCM của người dùng (app Android / trình duyệt). Một token chỉ thuộc một người:
/// đăng nhập tài khoản khác trên cùng máy thì token chuyển sang người mới. Token hỏng (FCM báo) thì xoá.
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(512)
  /// android | ios | web
  platform   String   @db.VarChar(16)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

/// Từ khoá người dùng đã tìm (trang kết quả tìm kiếm). Mỗi người giữ tối đa 10 từ khoá mới nhất;
/// cũng là nguồn tính "Tìm nhiều" (trending) và gợi ý khi gõ.
model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Từ khoá như người dùng gõ (đã bỏ khoảng trắng thừa)
  keyword    String
  /// Từ khoá bỏ dấu, chữ thường, để gộp bản trùng ("Ghế gỗ" = "ghe go")
  normalized String
  searchedAt DateTime @default(now())

  @@unique([userId, normalized])
  @@index([userId, searchedAt])
  @@index([searchedAt])
}

model AiConversation {
  id String @id
  state Json @default("{}")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease String?
  busyUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turns AiTurn[]
  actions AiAction[]
  @@index([userId, updatedAt])
}

model AiTurn {
  id String @id @default(uuid())
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId String
  input String
  response Json
  contents Json
  createdAt DateTime @default(now())
  @@unique([conversationId, requestId])
  @@index([conversationId, createdAt])
}

model AiAction {
  id String @id
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  payload Json
  result Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([conversationId])
}

model AiUsage {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  windowCount Int
  dayStart DateTime
  dayCount Int
}

model AiKnowledgeChunk {
  id String @id @default(uuid())
  documentId String
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DateTime
  ordinal Int
  text String
  // Legacy vectors retained for an additive migration; new writes store vectors only in Qdrant.
  embedding Float[] @default([])
  collection String @default("")
  generation String @default("")
  model String
  @@unique([documentId, ordinal])
  @@index([model])
  @@index([collection, model])
}

model AiKnowledgeIndex {
  documentId String @id
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status String @default("IDLE")
  lease String?
  busyUntil DateTime?
  generation String?
  documentVersion DateTime?
  model String?
  collection String?
  indexedAt DateTime?
  errorCode String?
}

// Durable outbox: database deletion (including document cascade) queues Qdrant removal.
model AiVectorDeletion {
  pointId String
  collection String
  createdAt DateTime @default(now())
  @@id([pointId, collection])
  @@index([collection, createdAt])
}

model UserFollow {
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  threadId String?
  thread Conversation? @relation("ThreadContexts", fields: [threadId], references: [id], onDelete: Cascade)
  contexts Conversation[] @relation("ThreadContexts")
  @@index([threadId, updatedAt])
  listingId String?
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  trade ListingTrade?
  offers Offer[]
  id        String @id @default(uuid())
  pairKey   String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ConversationMember[]
  messages  Message[]
  @@index([listingId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// Đề nghị giá của người mua trên một tin, trong hội thoại của tin đó (conversationId = cặp tin + người mua).
/// Mỗi hội thoại chỉ có một đề nghị PENDING (partial unique index trong migration).
model Offer {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        String
  sellerId       String
  amount         Decimal
  /// Giá niêm yết lúc gửi đề nghị
  listedPrice    Decimal
  status         OfferStatus   @default(PENDING)
  /// Người bán không phản hồi trước thời điểm này thì đề nghị hết hiệu lực
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  trade          ListingTrade?

  @@index([conversationId, createdAt])
  @@index([listingId, status])
  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
}

/// Thỏa thuận: người bán đã chấp nhận một đề nghị. Mở quyền đánh giá hai chiều trong 30 ngày;
/// đánh giá đầu tiên mở thêm 7 ngày chờ bên còn lại, rồi công khai (double-blind).
/// Một tin có thể có nhiều thỏa thuận (mỗi người mua một hội thoại).
model ListingTrade {
  conversationId String        @id
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offerId        String?       @unique
  offer          Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  listingId      String
  sellerId       String
  buyerId        String
  title          String
  /// Giá đã thống nhất
  price          Decimal
  /// Giá niêm yết lúc chấp nhận
  listedPrice    Decimal?
  image          String?
  acceptedAt     DateTime      @default(now())
  /// Hạn gửi đánh giá đầu tiên (acceptedAt + 30 ngày)
  reviewDeadline DateTime
  /// Đánh giá đầu tiên + 7 ngày: tới lúc này đánh giá được công khai dù bên kia chưa gửi
  revealAt       DateTime?
  /// Lượt đánh giá đã đóng (đã công khai hoặc hết hạn mà không ai đánh giá)
  closedAt       DateTime?
  reviews        TradeReview[]

  @@index([listingId])
  @@index([sellerId, acceptedAt])
  @@index([buyerId, acceptedAt])
  @@index([closedAt, revealAt])
  @@index([closedAt, reviewDeadline])
}

model TradeReview {
  id             String       @id @default(uuid())
  conversationId String
  trade          ListingTrade @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  authorId       String
  author         User         @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User         @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  fromSeller     Boolean
  stars          Int
  comment        String       @default("") @db.VarChar(500)
  tags           String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  /// null: còn giữ kín (chờ bên kia hoặc chờ đủ 7 ngày); chỉ tính vào điểm khi đã công khai
  publishedAt    DateTime?
  /// Phản hồi công khai một lần của người được đánh giá
  reply          String?      @db.VarChar(500)
  repliedAt      DateTime?
  /// Admin gỡ sau báo cáo: không hiển thị, không tính điểm
  removedAt      DateTime?
  removedReason  String?      @db.VarChar(500)

  @@unique([conversationId, authorId])
  @@index([recipientId, createdAt])
  @@index([recipientId, publishedAt])
}

model ConversationMember {
  conversationId String
  userId String
  blocked Boolean @default(false)
  hidden Boolean @default(false)
  lastReadSequence Int @default(0)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(uuid())
  sequence Int @unique @default(autoincrement())
  conversationId String
  senderId String
  clientId String
  text String @db.VarChar(2000)
  listingPreview Json?
  mediaName String?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, sequence])
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

/// Trạng thái bản sửa của tin đã duyệt
enum ListingRevisionStatus {
  PENDING
  REJECTED
}

/// Bản sửa của tin đã duyệt, chờ duyệt lại. Trong lúc chờ, tin vẫn hiện bản cũ;
/// duyệt thì nội dung bản sửa thay vào tin, từ chối thì tin giữ nguyên bản cũ.
/// Chuyên mục, thời gian hiển thị, xu đã trả, đẩy tin, Hot sale không nằm ở đây nên sửa tin không đổi được.
model ListingRevision {
  listingId     String                @id
  listing       Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status        ListingRevisionStatus @default(PENDING)
  title         String
  description   String
  price         Decimal
  isNegotiable  Boolean
  isFree        Boolean               @default(false)
  multipleUnits Boolean               @default(false)
  meetUp        Boolean               @default(true)
  condition     ListingCondition?
  allowSale     Boolean
  allowExchange Boolean
  exchangeWish  String
  attributes    Json                  @default("{}")
  location      Json?
  images        String[]
  reviewReason  String?
  /// Nội dung bị gắn cờ (SĐT, link, hàng cấm) lúc gửi duyệt: người đăng đã được cảnh báo và vẫn gửi
  flagged       Boolean               @default(false)
  /// Kết quả AI xem ảnh và nội dung lúc chờ duyệt: { hash, verdict OK | SUSPECT | UNKNOWN, reason, checkedAt }; hash khác nội dung hiện tại thì xem lại
  aiReview      Json?
  submittedAt   DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, submittedAt])
}

enum ListingStatus {
  DRAFT
  PENDING
  REJECTED
  AVAILABLE
  HIDDEN
  RESERVED
  SOLD
  EXCHANGED
}

model Listing {
  conversations Conversation[]
  aiIndex AiListingIndex?
  feedPosts FeedPost[]
  id            String           @id @default(uuid())
  /// Mã số ngắn tự tăng dùng trong URL đẹp (/listings/<tên>-<shortId>)
  shortId       Int              @unique @default(autoincrement())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  /// Danh mục con (id trong Category.metadata.subcategories của danh mục cha), khoá cùng categoryId sau khi duyệt
  subcategoryId String?
  title         String
  description   String
  price         Decimal
  /// false = giá cố định: người mua chỉ đề nghị đúng giá đăng
  isNegotiable  Boolean          @default(true)
  /// Cho tặng miễn phí (giá 0, không nhận trả giá)
  isFree        Boolean          @default(false)
  /// Người bán có nhiều món giống nhau: nhận đề nghị không giữ hàng cho riêng ai
  multipleUnits Boolean          @default(false)
  /// Gặp mặt giao dịch tại khu vực của tin (false = thỏa thuận cách giao qua chat)
  meetUp        Boolean          @default(true)
  condition     ListingCondition?
  status        ListingStatus    @default(AVAILABLE)
  allowSale     Boolean          @default(true)
  allowExchange Boolean          @default(false)
  exchangeWish  String           @default("")
  sellerType    String           @default("PERSONAL")
  attributes    Json             @default("{}")
  location      Json?
  reviewReason  String?
  images        String[]         
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  publishedAt   DateTime?
  /// Số xu đã giữ/trừ để đăng tin vượt hạn mức; 0 = tin dùng suất miễn phí
  paidCredits   Int              @default(0)
  /// Hết hạn hiển thị (duyệt / kích hoạt lại / gia hạn mới đặt); quá hạn thì tự ẩn
  expiresAt     DateTime?
  /// Ngày hẹn bắt đầu hiển thị (null = hiện ngay khi duyệt). Tin đã duyệt mà chưa tới ngày: HIDDEN + startsAt
  startsAt      DateTime?
  /// Số ngày hiển thị người bán chọn lúc đăng, tính khi duyệt (null = số ngày miễn phí)
  displayDays   Int?
  /// Số ngày hiển thị đã trả xu lúc đăng
  paidDays      Int              @default(0)
  /// Tự gia hạn 30 ngày khi sắp hết hạn (gói có StorePackage.autoExtend)
  autoExtend    Boolean          @default(false)
  /// Nội dung bị gắn cờ (SĐT, link, hàng cấm) lúc gửi duyệt: người đăng đã được cảnh báo và vẫn gửi
  flagged       Boolean          @default(false)
  /// Kết quả AI xem ảnh và nội dung lúc chờ duyệt: { hash, verdict OK | SUSPECT | UNKNOWN, reason, checkedAt }; hash khác nội dung hiện tại thì xem lại
  aiReview      Json?
  updatedAt     DateTime         @updatedAt
  creditHolds   CreditHold[]
  promotions    Promotion[]
  favorites     ListingFavorite[]
  recentViews   ListingRecentView[]
  promotionOrders PromotionOrder[]
  wantedAlertMatches WantedAlertMatch[]
  viewDays      ListingViewDaily[]
  posters       ShopBanner[]
  /// Bản sửa đang chờ duyệt lại (chỉ tin đã duyệt: đang hiển thị / đã ẩn)
  revision      ListingRevision?
  offers        Offer[]

  @@index([ownerId, publishedAt])
  @@index([ownerId, categoryId, status])
  @@index([categoryId, subcategoryId, status])
  @@index([status, expiresAt])
  @@index([status, startsAt])
  @@index([isFree, status])
}

/// Lượt xem tin theo ngày (giờ Việt Nam), cộng cùng lúc với Listing.viewCount; dùng cho trang Thống kê
model ListingViewDaily {
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@id([listingId, day])
  @@index([day])
}

model AiListingIndex {
  listingId String @id
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pointId String @unique
  sourceHash String
  model String
  collection String
  indexedAt DateTime @default(now())
  @@index([collection, model])
}

/// Tin người dùng vừa xem (trang Xem gần đây), giữ 30 tin mới nhất mỗi người
model ListingRecentView {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@id([userId, listingId])
  @@index([userId, viewedAt])
}

model ListingFavorite {
  userId String
  listingId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
  @@index([listingId])
}

model Category {
  active         Boolean             @default(true)
  id             String              @id
  name           String
  metadata       Json                @default("{}")
  /// Tài khoản Cá nhân: số tin miễn phí đang hiển thị/chờ duyệt trong chuyên mục
  freeListingLimit    Int            @default(2)
  /// Giá (xu) một tin vượt hạn mức, hiển thị 60 ngày
  extraListingCredits Int            @default(5)
  /// Số ngày hiển thị miễn phí của gói Cá nhân (gói cao nhân theo StorePackage.freeDaysPercent)
  displayDays         Int            @default(60)
  /// Thời gian hiển thị tối đa (ngày, tính từ hôm nay) khi chọn ngày đăng hoặc gia hạn
  maxDisplayDays      Int            @default(120)
  /// Giá (xu) cho 30 ngày hiển thị thêm; giá một ngày = giá này / 30, làm tròn lên
  dayPackCredits      Int            @default(4)
  /// Giá (xu) một lần đẩy tin lên đầu, trước khi giảm theo gói
  boostCredits        Int            @default(5)
  listings       Listing[]
  subscriptions  StoreSubscription[]
  storeOrders    StoreOrder[]
  wantedAlerts   WantedAlert[]
}

enum StoreTier {
  PERSONAL
  BASIC
  PRO
}

model StorePackage {
  id                    String              @id
  tier                  StoreTier           @unique
  name                  String
  monthlyPrice          Decimal
  dailyListingLimit     Int
  activeListingLimit    Int
  /// Số tin nháp được giữ cùng lúc
  draftLimit            Int                 @default(3)
  monthlyPromotionQuota Int
  /// Phần trăm giảm giá đẩy tin bằng xu của gói
  boostDiscountPercent  Int                 @default(0)
  /// Số ngày hiển thị miễn phí theo % của Category.displayDays (Cá nhân 100, Bán chuyên 150, Cửa hàng 200)
  freeDaysPercent       Int                 @default(100)
  /// Giảm giá (%) khi mua thêm ngày hiển thị
  extendDiscountPercent Int                 @default(0)
  /// Được bật tự gia hạn tin 30 ngày khi sắp hết hạn
  autoExtend            Boolean             @default(false)
  /// Poster shop chạy (hoặc chờ duyệt) cùng lúc; 0 = gói không được đăng poster
  posterActiveLimit     Int                 @default(0)
  /// Poster gửi duyệt mỗi tháng (tính theo ngày tạo)
  posterMonthlyLimit    Int                 @default(0)
  priorityLevel         Int
  subscriptions         StoreSubscription[]
  orders                StoreOrder[]
}

model StoreSubscription {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   StorePackage @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])
  startsAt  DateTime     @default(now())
  endsAt    DateTime
  updatedAt DateTime     @updatedAt
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model StoreOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    StorePackage     @relation(fields: [packageId], references: [id])
  categoryId String
  category   Category         @relation(fields: [categoryId], references: [id])
  amount     Decimal
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  @@index([userId, status])
}

model PromotionPackage {
  id           String      @id
  name         String
  kind         PromotionKind
  durationDays Int
  price        Decimal
  priority     Int
  active       Boolean     @default(true)
  promotions   Promotion[]
  orders       PromotionOrder[]
}

enum PromotionKind {
  BUMP
  FEATURED
}

enum PromotionSource {
  INCLUDED
  PURCHASED
}

model Promotion {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId String
  package   PromotionPackage @relation(fields: [packageId], references: [id])
  source    PromotionSource  @default(INCLUDED)
  orderId   String?          @unique
  order     PromotionOrder?  @relation(fields: [orderId], references: [id])
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([listingId, endsAt])
}

model PromotionOrder {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  packageId  String
  package    PromotionPackage @relation(fields: [packageId], references: [id])
  amount     Decimal
  status     PurchaseStatus   @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?
  promotion  Promotion?

  @@index([userId, status])
}

/// Từ / cụm từ admin thêm vào bộ lọc nội dung tin (ngoài luật có sẵn trong code); code: CONTACT | BANNED
model BannedTerm {
  id        String   @id @default(uuid())
  /// Chữ thường, đã trim; khớp nguyên từ, không phân biệt hoa thường
  term      String   @unique
  code      String
  createdAt DateTime @default(now())
}
model AdminAudit {
  id String @id @default(uuid())
  actorId String
  action String
  targetType String
  targetId String
  reason String
  before Json?
  after Json?
  /// Người bị ảnh hưởng (VD chủ tin bị kiểm duyệt): giữ lịch sử vi phạm cả khi tin đã bị xoá
  subjectId String?
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@index([subjectId, createdAt])
  @@index([createdAt])
}
model ConditionPolicy {
  condition ListingCondition @id
  name String
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
model ReportReason {
  code String @id
  labelVi String
  labelEn String
  requiresDescription Boolean @default(false)
  guidanceVi String?
  guidanceEn String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ViolationReport {
  id String @id @default(uuid())
  reporterId String
  targetType String
  targetId String
  reason String
  evidence String
  reasonCode String?
  contactPhone String?
  contactEmail String?
  status ReportStatus @default(OPEN)
  decision String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId, status, createdAt])
  @@index([status, reasonCode, createdAt])
}
model SupportTicket {
  id String @id @default(uuid())
  userId String
  subject String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages SupportMessage[]
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}
model SupportMessage {
  id String @id @default(uuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  isAdmin Boolean
  content String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model KnowledgeDocument {
  aiChunks AiKnowledgeChunk[]
  aiIndex AiKnowledgeIndex?
  id String @id @default(uuid())
  title String
  content String
  indexedText String?
  syncedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}
model FeedPost {
  id String @id @default(uuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text String @db.VarChar(2000)
  imageUrl String?
  listingId String?
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes FeedPostLike[]
  comments FeedComment[]
  @@index([createdAt, id])
  @@index([authorId, createdAt, id])
}
model FeedPostLike {
  postId String
  userId String
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([postId, userId])
}
model FeedComment {
  id String @id @default(uuid())
  postId String
  authorId String
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text String @db.VarChar(2000)
  imageUrl String?
  parentId String?
  parent FeedComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies FeedComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes FeedCommentLike[]
  @@index([postId, createdAt, id])
  @@index([parentId, createdAt, id])
}
model FeedCommentLike {
  commentId String
  userId String
  comment FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([commentId, userId])
}

/// Banner ảnh ở trang chủ (ảnh 1200 × 600). Admin quản lý qua /api/v1/home/admin/banners.
model HomeBanner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String?
  route     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

enum WantedAlertMatchLevel {
  BROAD
  BALANCED
  STRICT
}

/// "Báo khi có hàng": người dùng đặt trước món muốn mua. Khi admin duyệt một tin
/// gần giống (điểm >= ngưỡng của matchLevel) thì ghi một WantedAlertMatch.
/// API: /api/v1/wanted-alerts. Xóa dòng là dừng thông báo.
model WantedAlert {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords      String
  categoryId    String?
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Danh mục con (id trong Category.metadata.subcategories của categoryId); null là mọi danh mục con
  subcategoryId String?
  /// Khoảng giá VND, null là không giới hạn
  minPrice      BigInt?
  maxPrice      BigInt?
  /// Rỗng là mọi tình trạng / mọi kiểu giao dịch ("buy", "exchange")
  conditions    ListingCondition[]
  dealTypes     String[]
  /// Khu vực: mã tỉnh (areaLevel "province") hoặc mã phường ("ward"); null là toàn quốc
  areaCode      String?
  areaLevel     String?
  areaLabel     String?
  matchLevel    WantedAlertMatchLevel @default(BALANCED)
  /// Lần cuối người dùng mở xem tin khớp; tin khớp sau mốc này là tin mới
  seenAt        DateTime              @default(now())
  lastMatchedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  matches       WantedAlertMatch[]

  @@index([userId, createdAt])
  @@index([categoryId])
}

/// Một tin đã khớp một thông báo, kèm điểm giống 0..1
model WantedAlertMatch {
  alertId   String
  alert     WantedAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Float
  matchedAt DateTime    @default(now())

  @@id([alertId, listingId])
  @@index([alertId, matchedAt])
  @@index([listingId])
}

/// Xu ReStore (credit). 1 xu = 1.000 đ. Số dư = tổng CreditTransaction.amount
enum CreditPayMethod {
  VNPAY
  VIETQR
  ZALOPAY
}

enum TopupStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum CreditTxnType {
  TOPUP
  BONUS
  SPEND
  REFUND
  EXPIRE
  ADJUST
}

/// Xu nạp (PAID) hay xu tặng (BONUS); tiêu xu tặng trước
enum CreditBucket {
  PAID
  BONUS
}

/// Gói nạp xu, admin sửa được
model CreditPackage {
  id           String             @id
  priceVnd     Int
  credits      Int
  bonusCredits Int                @default(0)
  popular      Boolean            @default(false)
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  orders       CreditTopupOrder[]
}

/// Đơn nạp xu; chỉ chuyển PAID khi cổng xác nhận (IPN có chữ ký) hoặc cổng thử
model CreditTopupOrder {
  id            String              @id @default(uuid())
  /// Mã ngắn ghi vào nội dung chuyển khoản
  code          String              @unique
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       CreditPackage       @relation(fields: [packageId], references: [id])
  method        CreditPayMethod
  amountVnd     Int
  credits       Int
  bonusCredits  Int                 @default(0)
  status        TopupStatus         @default(PENDING)
  /// Mã giao dịch của cổng, mỗi mã chỉ cộng xu một lần
  providerTxnId String?             @unique
  /// Mã đơn bên cổng (ZaloPay app_trans_id) để hỏi trạng thái và khớp callback
  providerRef   String?             @unique
  /// Trang thanh toán của cổng
  payUrl        String?
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transactions  CreditTransaction[]
  sepayEvents   SepayWebhookEvent[]

  @@index([userId, status])
}

enum SepayEventStatus {
  /// Đã ghi nhận, đang xử lý (hoặc xử lý dở vì lỗi tạm, lần gửi lại sẽ xử lý tiếp)
  RECEIVED
  /// Giao dịch này đã trả đơn nạp và cộng xu
  PAID
  /// Tiền vào nhưng không trả được đơn nào: thiếu mã, sai số tiền, sai tài khoản, đơn không tồn tại. Cần người xem / hoàn tiền
  UNMATCHED
  /// Đơn đã được trả bằng giao dịch khác: khách trả lần 2, cần hoàn tiền
  DUPLICATE
  /// Không phải tiền vào, không liên quan nạp xu
  IGNORED
}

/// Mỗi giao dịch SePay đã xử lý: báo qua webhook, hoặc job đối soát tìm thấy qua API (webhook bị lỡ).
/// Bản ghi đối soát, giữ cả payload gốc. Chỉ admin / DB đọc
model SepayWebhookEvent {
  /// webhook: id giao dịch trong webhook (ổn định qua các lần gửi lại). API: "api:" + UUID giao dịch
  id              String            @id
  /// webhook | api (job đối soát)
  source          String            @default("webhook")
  /// UUID giao dịch trong SePay API v2 (khác id của webhook), để job đối soát không xử lý lại
  apiTransactionId String?          @unique
  status          SepayEventStatus  @default(RECEIVED)
  /// Kết quả đã trả cho SePay (success), lần gửi lại trả đúng kết quả này
  success         Boolean           @default(false)
  reason          String?
  transferType    String
  amountVnd       Int
  code            String?
  accountNumber   String?
  /// Mã tham chiếu của ngân hàng (không duy nhất), dùng khi tra soát với ngân hàng
  referenceCode   String?
  transactionDate String?
  topupOrderId    String?
  topupOrder      CreditTopupOrder? @relation(fields: [topupOrderId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([topupOrderId])
  @@index([referenceCode, amountVnd])
}

/// Trạng thái job đối soát SePay: con trỏ (UUID giao dịch API cuối cùng đã đọc)
model SepaySyncState {
  id        String   @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

/// Sổ cái xu: chỉ thêm, không sửa, không xoá
model CreditTransaction {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CreditTxnType
  bucket       CreditBucket
  /// Dương là cộng, âm là trừ
  amount       Int
  expiresAt    DateTime?
  topupOrderId String?
  topupOrder   CreditTopupOrder? @relation(fields: [topupOrderId], references: [id], onDelete: SetNull)
  note         String?
  /// Lần giữ xu khi đăng tin (trừ khi giữ, hoàn khi tin bị từ chối)
  holdId       String?
  hold         CreditHold?       @relation(fields: [holdId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@unique([topupOrderId, type])
  @@index([userId, createdAt])
}

enum CreditHoldStatus {
  /// Đã trừ khỏi ví, chờ admin duyệt tin
  HELD
  /// Tin đã duyệt, xu tiêu hẳn
  CAPTURED
  /// Tin bị từ chối hoặc huỷ, xu đã hoàn
  RELEASED
}

/// Xu giữ khi gửi tin vượt hạn mức: trừ ngay khỏi số dư, duyệt thì tiêu hẳn, từ chối thì hoàn
model CreditHold {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  amount       Int
  /// Phần lấy từ xu tặng / xu nạp, để hoàn đúng loại
  bonusAmount  Int
  paidAmount   Int
  status       CreditHoldStatus    @default(HELD)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions CreditTransaction[]

  @@index([userId, status])
  @@index([listingId, status])
}

/// Mốc mua ngày hiển thị rẻ hơn (30 / 60 / 90 ngày), admin sửa được
model DisplayDayPack {
  days            Int     @id
  discountPercent Int
  active          Boolean @default(true)
}

/// Cách shop được xác minh: shop gốc của thương hiệu, hoặc ReStore kiểm tra giấy tờ và cấp chứng nhận
enum ShopVerificationType {
  OFFICIAL_BRAND
  CERTIFIED
}

enum ShopBannerStatus {
  PENDING
  APPROVED
  REJECTED
  /// Shop tự dừng (poster đang chạy) hoặc hủy (poster chờ duyệt)
  STOPPED
}

/// Lý do admin từ chối poster shop
enum ShopBannerRejectReason {
  WRONG_SIZE
  MISLEADING_PRICE
  BRAND_MISUSE
  PROHIBITED
  TOO_MUCH_TEXT
  OTHER
}

/// Duyệt cửa hàng: mở shop hoặc sửa shop bị từ chối thì chờ duyệt.
/// Chỉ shop đã duyệt (hoặc đã xác minh) mới có trang công khai
enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Gian hàng của một tài khoản bán (thường là gói Cửa hàng). Chỉ hiện ở "Shop uy tín" khi đã xác minh
model Shop {
  id               String                @id @default(uuid())
  ownerId          String                @unique
  owner            User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  tagline          String                @default("")
  description      String                @default("")
  logoUrl          String?
  coverUrl         String?
  /// Màu nhận diện hex, VD "#1428A0"
  accentColor      String?
  /// null = chưa xác minh
  verificationType ShopVerificationType?
  verifiedAt       DateTime?
  /// Mã chứng nhận ReStore cấp, VD "RS-2026-00128"
  certificateCode  String?
  categoryIds      String[]
  /// Địa chỉ hiển thị, VD "Quận 1, TP. Hồ Chí Minh"
  address          String?
  /// Liên hệ công khai ở trang shop (mục Thông tin liên hệ); null = chưa đặt (số điện thoại thì dùng số của chủ shop)
  contactPhone     String?
  businessEmail    String?
  website          String?
  status           ShopStatus            @default(PENDING)
  /// Lần gửi duyệt gần nhất (mở shop, hoặc sửa sau khi bị từ chối); hàng chờ duyệt xếp cũ trước
  submittedAt      DateTime              @default(now())
  reviewedAt       DateTime?
  /// Lý do admin từ chối; chủ shop sửa rồi lưu là gửi duyệt lại
  rejectNote       String?
  /// Giờ mở cửa theo thứ: [{ day: 1-7 (1 = thứ Hai, 7 = Chủ nhật), open: "08:00", close: "21:00" }]; null = chưa đặt
  openingHours     Json?
  /// Phiên bản hợp đồng Cửa hàng chủ shop đã đồng ý lúc đăng ký, VD "2026-11"; null = shop cũ, mở trước khi có hợp đồng
  termsVersion     String?
  termsAcceptedAt  DateTime?
  /// Phí đăng ký cửa hàng đã trả (xu)
  registrationCredits Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  banners          ShopBanner[]
  verification     ShopVerification?

  @@index([verificationType, verifiedAt])
  @@index([status, submittedAt])
}

/// Hồ sơ xin xác minh shop (giấy phép kinh doanh): mỗi shop một hồ sơ, gửi lại thì ghi đè. Duyệt thì shop
/// có verificationType (hiện ở Shop uy tín). Ảnh giấy tờ ở khu riêng, chỉ chủ shop và admin xem được
model ShopVerification {
  id           String     @id @default(uuid())
  shopId       String     @unique
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status       ShopStatus @default(PENDING)
  /// Tên doanh nghiệp / hộ kinh doanh trên giấy phép
  businessName String
  /// Mã số doanh nghiệp / mã số thuế: 10 số, chi nhánh thêm "-001"
  taxCode      String
  /// Ảnh giấy phép kinh doanh (1-3 ảnh, /api/v1/media/verifications/...)
  documentUrls String[]
  submittedAt  DateTime   @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  rejectNote   String?

  @@index([status, submittedAt])
}

/// Banner sự kiện shop gửi lên (ảnh 1200 x 600), admin duyệt rồi mới hiện
model ShopBanner {
  id        String           @id @default(uuid())
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String
  startsAt  DateTime?
  endsAt    DateTime?
  status    ShopBannerStatus @default(PENDING)
  /// Bấm poster mở tin này của shop; null = mở trang shop
  listingId String?
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  rejectReason ShopBannerRejectReason?
  /// Ghi chú thêm của admin khi từ chối
  rejectNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  @@index([shopId, status])
  @@index([status, createdAt])
}

/// Địa chỉ đã lưu để chọn lại khi đăng tin (tối đa 5 mỗi người, tự lưu khi đăng / sửa tin)
/// Khu vực (tỉnh/thành hoặc phường/xã) người dùng chọn gần đây ở trang chọn khu vực, tối đa 8 mỗi người
model RecentArea {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mã tỉnh/thành hoặc phường/xã (catalog locations)
  code   String   @db.VarChar(10)
  usedAt DateTime @default(now())

  @@id([userId, code])
  @@index([userId, usedAt])
}

model SavedAddress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tên tự đặt, VD "Nhà", "Cửa hàng"; null = chưa đặt
  label         String?  @db.VarChar(40)
  provinceCode  String   @db.VarChar(10)
  wardCode      String   @db.VarChar(10)
  streetAddress String   @default("") @db.VarChar(200)
  /// Số nhà/đường đã bỏ dấu, chữ thường, gộp khoảng trắng: để không lưu trùng
  streetKey     String   @default("") @db.VarChar(200)
  latitude      Float
  longitude     Float
  /// device | ward_center
  geoSource     String   @default("ward_center") @db.VarChar(16)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, wardCode, streetKey])
  @@index([userId, lastUsedAt])
}
