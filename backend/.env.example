# =====================================================================
# Restore backend - mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# (bắt buộc) = server không chạy nếu thiếu
# =====================================================================

# --- Server ----------------------------------------------------------
PORT=3000
# development | production | test
NODE_ENV="development"
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy (để trống = cho phép tất cả khi dev)
CORS_ORIGINS=""

# --- Database (Supabase Postgres) ------------------------------------
# (bắt buộc) Transaction pooler, cổng 6543 - app dùng khi chạy
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session pooler / kết nối trực tiếp, cổng 5432 - Prisma dùng khi migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (JWT / OTP) ------------------------------------------------
# (bắt buộc) Khóa ký access token
JWT_SECRET="change-me"
# Bắt buộc khi NODE_ENV=production, mỗi khóa tối thiểu 32 ký tự và khác nhau
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""
OTP_SECRET=""

# --- Email (Resend) --------------------------------------------------
# (bắt buộc)
RESEND_API_KEY="re_xxxxxxxx"
# (bắt buộc) Khi chưa xác thực domain thì dùng onboarding@resend.dev
EMAIL_FROM="onboarding@resend.dev"
# Khi dev: gửi mọi email về địa chỉ này (tài khoản Resend chưa có domain chỉ gửi được cho chính mình)
RESEND_TEST_RECIPIENT=""

# --- Storage (ảnh tin đăng) ------------------------------------------
# disk = lưu trên máy chạy server | supabase = lưu trên Supabase Storage
STORAGE_DRIVER="disk"
# Chỉ dùng với disk: thư mục lưu file (mặc định ./uploads)
STORAGE_DISK_ROOT=""
# Chỉ dùng với supabase:
# Project URL: Supabase > Project Settings > Data API
SUPABASE_URL="https://<project-ref>.supabase.co"
# Secret key (sb_secret_...) ở Project Settings > API Keys, hoặc service_role (legacy).
# Chỉ để ở backend, KHÔNG đưa vào app Flutter. Không dùng Publishable key.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket private, tạo sẵn trong Supabase > Storage
SUPABASE_STORAGE_BUCKET="media"
