# =====================================================================
# Restore backend - mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# (bắt buộc) = server không chạy nếu thiếu
# =====================================================================

# --- Server ----------------------------------------------------------
PORT=3000
# development | production | test
NODE_ENV="development"
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy (để trống = cho phép tất cả khi dev)
CORS_ORIGINS=""
# Số lớp proxy đứng trước server (VD 1 khi deploy sau Nginx / Render / Railway) để rate limit đọc đúng
# IP người dùng. Để trống khi chạy thẳng trên máy.
TRUST_PROXY=""

# --- Database (Supabase Postgres) ------------------------------------
# (bắt buộc) Transaction pooler, cổng 6543 - app dùng khi chạy
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session pooler / kết nối trực tiếp, cổng 5432 - Prisma dùng khi migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (JWT / OTP) ------------------------------------------------
# (bắt buộc) Khóa ký access token
JWT_SECRET="change-me"
# Bắt buộc khi NODE_ENV=production, mỗi khóa tối thiểu 32 ký tự và khác nhau
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""
OTP_SECRET=""

# --- Email (Resend) --------------------------------------------------
# (bắt buộc)
RESEND_API_KEY="re_xxxxxxxx"
# (bắt buộc) Khi chưa xác thực domain thì dùng onboarding@resend.dev
EMAIL_FROM="onboarding@resend.dev"
# Khi dev: gửi mọi email về địa chỉ này (tài khoản Resend chưa có domain chỉ gửi được cho chính mình)
RESEND_TEST_RECIPIENT=""

# --- Gợi ý địa chỉ (ô số nhà, tên đường) -----------------------------
# photon = miễn phí, dữ liệu OpenStreetMap, không cần key (mặc định) | off = tắt
ADDRESS_PROVIDER="photon"
# Tự host Photon thì đổi URL (mặc định https://photon.komoot.io)
PHOTON_URL=""

# --- Storage (ảnh, video người dùng tải lên) --------------------------
# disk = lưu trên máy chạy server (dev / test) | cloudinary = lưu trên Cloudinary, ảnh tải thẳng từ CDN
STORAGE_DRIVER="disk"
# Chỉ dùng với disk: thư mục lưu file (mặc định ./uploads)
STORAGE_DISK_ROOT=""
# Chỉ dùng với cloudinary: Cloudinary Console > Settings > API Keys > "API environment variable".
# Dạng cloudinary://<api_key>:<api_secret>@<cloud_name>. Chỉ để ở backend, KHÔNG đưa vào app Flutter.
CLOUDINARY_URL=""
# Thư mục gốc trên Cloudinary (mặc định media): file nằm ở <thư mục>/<listings|feeds|avatars|...>/
CLOUDINARY_ROOT_FOLDER="media"

# --- Thanh toán xu ReStore -------------------------------------------
# File này là cấu hình MÁY DEV: chỉ điền giá trị sandbox / Test Mode. Giá trị thật của production
# chỉ đặt trên server, không để trên máy dev. Biến bắt buộc ở production: src/modules/credits/credit.config.ts.
# "sandbox" = bật nút giả lập kết quả trả tiền (phải ghi rõ, để trống là tắt) | "live" = tiền thật
PAYMENT_MODE="sandbox"
# Debug: "true" = bỏ qua cổng ZaloPay, đơn chỉ trả bằng nút giả lập (chỉ khi sandbox)
PAYMENT_SKIP_GATEWAY=""
# Tài khoản nhận chuyển khoản VietQR (BIN ngân hàng, số TK, tên không dấu). Để trống thì không có VietQR.
# Test Mode của SePay: dùng tài khoản thử SePay tạo (VD VietinBank, BIN 970415, số TK của Test Mode)
VIETQR_BANK_BIN=""
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
# --- SePay: 3 biến, 3 việc khác nhau ----------------------------------
# Webhook (SePay → backend, /api/v1/payments/sepay/webhook) báo có tiền vào. Chọn MỘT trong hai cách xác thực
# giống với kiểu đã chọn khi tạo webhook trên my.sepay.vn. Test Mode dùng webhook của Test Mode.

# (1) Webhook, xác thực "HMAC-SHA256" (khuyến nghị, đang dùng): Secret Key của webhook (my.sepay.vn → Webhooks).
#     Có biến này thì backend kiểm chữ ký HMAC và bỏ qua (2).
SEPAY_WEBHOOK_SECRET=""
# (2) Webhook, xác thực "API Key" (kiểu cũ, yếu hơn HMAC): chỉ điền khi webhook chọn kiểu "API Key".
#     Đang dùng HMAC thì để trống. KHÔNG phải API key ở mục "API" của SePay (đó là biến (3)).
SEPAY_WEBHOOK_API_KEY=""
# (3) API key để backend GỌI SePay (backend → SePay API v2), cho job đối soát: mỗi 5 phút kéo giao dịch
#     tiền vào, giao dịch nào webhook bị lỡ thì xử lý bù. Tạo ở my.sepay.vn → Cài đặt công ty → API Keys
#     (Test Mode dùng key Test Mode). PAYMENT_MODE="live" gọi API thật, còn lại gọi API sandbox. Để trống = tắt đối soát.
SEPAY_API_TOKEN=""

# ZaloPay sandbox (key thử công khai trong repo zalopay-samples/test-apps, chỉ dùng để test)
# Đổi sang key thật + ZALOPAY_ENDPOINT thật khi chạy production. Để trống app id thì không có ZaloPay.
ZALOPAY_APP_ID="2554"
ZALOPAY_KEY1="sdngKKJmqEMzvh5QQcdD2A9XBSKUNaYn"
ZALOPAY_KEY2="trMrHtvjo6myautxDUiAcYsVtaeQ8nhf"
# Mặc định https://sb-openapi.zalopay.vn/v2 (sandbox). Chưa đặt PAYMENT_MODE="live" thì luôn dùng sandbox dù điền gì ở đây
ZALOPAY_ENDPOINT=""
# Cách trả hiện trên trang ZaloPay, cách nhau dấu phẩy: domestic_card (mặc định), international_card, account, zalopay_wallet, vietqr; "all" = tất cả
ZALOPAY_METHODS=""
# Địa chỉ public của backend (VD https://xxx.ngrok-free.app) để ZaloPay gọi callback.
# Để trống khi chạy localhost: backend tự hỏi ZaloPay mỗi lần app kiểm tra đơn.
PUBLIC_API_URL=""
# Trang ZaloPay chuyển về sau khi trả. Mặc định PUBLIC_API_URL (hoặc localhost) + /api/v1/payments/zalopay/return.
# Test trên điện thoại thật mà không có PUBLIC_API_URL: điền IP LAN, VD http://192.168.1.10:3000/api/v1/payments/zalopay/return
ZALOPAY_REDIRECT_URL=""

# --- Push thông báo (Firebase Cloud Messaging, miễn phí) ----------------
# Đường dẫn file khoá service account (.json) tải ở Firebase Console > Project settings > Service accounts.
# Để file NGOÀI thư mục repo (VD D:\DartProject\keys\restore-firebase.json). Để trống = tắt push.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Server deploy (không có file): dán nội dung file .json, nguyên văn hoặc base64. Có thì dùng cái này thay cho PATH.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Xác minh số điện thoại (Firebase Phone Auth): project id để kiểm ID token app gửi lên, không phải bí mật.
# Để trống thì lấy project_id trong khoá service account ở trên; cả hai trống = tắt xác minh số điện thoại.
FIREBASE_PROJECT_ID="restore-5cfcb"

# --- ReStore AI (backend only) --------------------------------------
# Disabled by default; configure key and deploy migrations before enabling.
AI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# Model xem ảnh tin đăng (AI soạn tin, AI kiểm tra tin chờ duyệt); để trống thì dùng GEMINI_MODEL
GEMINI_VISION_MODEL=""

# Qdrant Cloud Cluster Endpoint and Cluster API key (read/write, backend only).
# Copy the HTTPS endpoint from your cluster, including its port if present.
QDRANT_URL=""
QDRANT_API_KEY=""
# Use different collections for development and production.
QDRANT_COLLECTION="restore_knowledge_dev_v1"
# Optional: defaults to QDRANT_COLLECTION + _listings; must be separate from knowledge.
QDRANT_LISTING_COLLECTION=""
AI_LISTING_INDEX_BATCH_SIZE="10"
AI_LISTING_INDEX_INTERVAL_MS="60000"
