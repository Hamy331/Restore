# =====================================================================
# Restore backend - mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# (bắt buộc) = server không chạy nếu thiếu
# =====================================================================

# --- Server ----------------------------------------------------------
PORT=3000
# development | production | test
NODE_ENV="development"
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy (để trống = cho phép tất cả khi dev)
CORS_ORIGINS=""

# --- Database (Supabase Postgres) ------------------------------------
# (bắt buộc) Transaction pooler, cổng 6543 - app dùng khi chạy
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session pooler / kết nối trực tiếp, cổng 5432 - Prisma dùng khi migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (JWT / OTP) ------------------------------------------------
# (bắt buộc) Khóa ký access token
JWT_SECRET="change-me"
# Bắt buộc khi NODE_ENV=production, mỗi khóa tối thiểu 32 ký tự và khác nhau
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""
OTP_SECRET=""

# --- Email (Resend) --------------------------------------------------
# (bắt buộc)
RESEND_API_KEY="re_xxxxxxxx"
# (bắt buộc) Khi chưa xác thực domain thì dùng onboarding@resend.dev
EMAIL_FROM="onboarding@resend.dev"
# Khi dev: gửi mọi email về địa chỉ này (tài khoản Resend chưa có domain chỉ gửi được cho chính mình)
RESEND_TEST_RECIPIENT=""

# --- Gợi ý địa chỉ (ô số nhà, tên đường) -----------------------------
# photon = miễn phí, dữ liệu OpenStreetMap, không cần key (mặc định) | off = tắt
ADDRESS_PROVIDER="photon"
# Tự host Photon thì đổi URL (mặc định https://photon.komoot.io)
PHOTON_URL=""

# --- Storage (ảnh tin đăng) ------------------------------------------
# disk = lưu trên máy chạy server | supabase = lưu trên Supabase Storage
STORAGE_DRIVER="disk"
# Chỉ dùng với disk: thư mục lưu file (mặc định ./uploads)
STORAGE_DISK_ROOT=""
# Chỉ dùng với supabase:
# Project URL: Supabase > Project Settings > Data API
SUPABASE_URL="https://<project-ref>.supabase.co"
# Secret key (sb_secret_...) ở Project Settings > API Keys, hoặc service_role (legacy).
# Chỉ để ở backend, KHÔNG đưa vào app Flutter. Không dùng Publishable key.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket private, tạo sẵn trong Supabase > Storage
SUPABASE_STORAGE_BUCKET="media"

# Xu ReStore: "sandbox" (mặc định, có nút giả lập kết quả trả tiền) hoặc "live"
PAYMENT_MODE="sandbox"
# Debug: "true" = bỏ qua cổng ZaloPay, đơn chỉ trả bằng nút giả lập (chỉ khi sandbox)
PAYMENT_SKIP_GATEWAY=""
# Tài khoản nhận chuyển khoản VietQR (BIN ngân hàng, số TK, tên không dấu). Để trống thì không có VietQR
VIETQR_BANK_BIN=""
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""

# ZaloPay sandbox (key thử công khai trong repo zalopay-samples/test-apps, chỉ dùng để test)
# Đổi sang key thật + ZALOPAY_ENDPOINT thật khi chạy production. Để trống app id thì không có ZaloPay.
ZALOPAY_APP_ID="2554"
ZALOPAY_KEY1="sdngKKJmqEMzvh5QQcdD2A9XBSKUNaYn"
ZALOPAY_KEY2="trMrHtvjo6myautxDUiAcYsVtaeQ8nhf"
# Mặc định https://sb-openapi.zalopay.vn/v2 (sandbox)
ZALOPAY_ENDPOINT=""
# Cách trả hiện trên trang ZaloPay, cách nhau dấu phẩy: domestic_card (mặc định), international_card, account, zalopay_wallet, vietqr; "all" = tất cả
ZALOPAY_METHODS=""
# Địa chỉ public của backend (VD https://xxx.ngrok-free.app) để ZaloPay gọi callback.
# Để trống khi chạy localhost: backend tự hỏi ZaloPay mỗi lần app kiểm tra đơn.
PUBLIC_API_URL=""
