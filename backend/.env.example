PORT=3000
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_ID].supabase.co:5432/postgres"
NODE_ENV="development"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_RESET_SECRET="replace-with-another-32-character-secret"
OTP_SECRET="replace-with-another-32-character-secret"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="no-reply@your-verified-domain.com"
# Only needed while EMAIL_FROM uses onboarding@resend.dev:
RESEND_TEST_RECIPIENT="your-resend-account@email.com"
# Comma-separated web origins. Native Flutter clients do not require CORS.
CORS_ORIGINS="http://localhost:3000"
