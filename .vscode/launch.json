{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ReStore (dev)",
      "type": "dart",
      "request": "launch",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env/dev.json"]
    },
    {
      "name": "ReStore (prod)",
      "type": "dart",
      "request": "launch",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=env/prod.json"]
    },
    {
      "name": "ReStore (dữ liệu mẫu)",
      "type": "dart",
      "request": "launch",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/dev.json",
        "--dart-define=USE_MOCK_DATA=true"
      ]
    }
  ]
}
